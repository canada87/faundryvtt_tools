<div class="recipe-book-content">
  {{#if isEmpty}}
    <div class="empty-state">
      <i class="fas fa-book-open"></i>
      <p>{{localize "CRAFTING.EmptyRecipeBook"}}</p>
    </div>
  {{else}}
    <div class="cb-toolbar">
      <div class="cb-search">
        <i class="fas fa-search" aria-hidden="true"></i>
        <input type="search" class="cb-field recipe-search" autocomplete="off"
               placeholder="{{localize 'CRAFTING.SearchPlaceholder'}}"
               aria-label="{{localize 'CRAFTING.SearchRecipes'}}" />
      </div>
      <div class="cb-seg" role="group">
        <button type="button" class="cb-seg-btn" data-action="filterAll" data-filter="all" aria-pressed="true">
          {{localize "CRAFTING.FilterAll"}}
        </button>
        <button type="button" class="cb-seg-btn" data-action="filterCraftable" data-filter="craftable" aria-pressed="false">
          {{localize "CRAFTING.FilterCraftable"}}<small>{{readyCount}}</small>
        </button>
      </div>
    </div>

    <div class="recipe-list">
      {{#each recipes}}
        <article class="recipe-card {{#unless canCraft}}disabled{{else}}ready{{/unless}}"
                 data-recipe-id="{{this.id}}" data-search="{{this.searchText}}">
          <div class="recipe-header">
            <img src="{{this.img}}" class="cb-tile xl ring recipe-icon" alt="" />
            <div class="recipe-title">
              <h3 class="recipe-name">{{this.name}}</h3>
              <p class="recipe-status">
                {{#if canCraft}}{{localize "CRAFTING.ReadyToCraft"}}
                {{else}}{{localize "CRAFTING.ComponentsProgress" have=this.haveCount total=this.components.length}}{{/if}}
              </p>
            </div>
            {{#if canCraft}}
              <button type="button" class="cb-btn cb-btn-primary craft-btn" data-action="craft"
                      title="{{localize 'CRAFTING.Craft'}}">
                <i class="fas fa-hammer"></i> {{localize "CRAFTING.Craft"}}
              </button>
            {{else}}
              <button type="button" class="cb-btn cb-btn-locked craft-btn" disabled
                      title="{{localize 'CRAFTING.MissingTitle'}}">
                {{localize "CRAFTING.Missing" n=this.missingCount}}
              </button>
            {{/if}}
          </div>

          {{#if this.description}}
            <p class="recipe-description">{{this.description}}</p>
          {{/if}}

          <ul class="ingredients">
            {{#each this.components}}
              <li class="ingredient {{#unless sufficient}}missing-item{{else}}has-item{{/unless}}"
                  style="--p: {{this.percent}}%"
                  title="{{this.name}}">
                <img src="{{this.img}}" class="cb-tile sm" alt="" />
                <span class="item-name">{{this.name}}</span>
                <span class="quantity">{{this.owned}}/{{this.quantity}}</span>
              </li>
            {{/each}}
          </ul>
        </article>
      {{/each}}
      <p class="no-results" hidden>{{localize "CRAFTING.NoResults"}}</p>
    </div>
  {{/if}}
</div>
