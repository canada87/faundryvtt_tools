<div class="st-content">
  {{#if session}}
    {{!-- Active session view --}}
    <header class="st-session-header">
      <div class="st-dc-badge">
        <span class="st-dc-label">{{localize "SAVING_THROW.DC"}}</span>
        <span class="st-dc-value">{{session.dc}}</span>
      </div>
      <div class="st-session-meta">
        <div class="st-mode-name">{{session.modeLabel}}</div>
        <div class="st-session-sub">
          {{#if session.dcVisible}}
            <span><i class="fas fa-eye" aria-hidden="true"></i> {{localize "SAVING_THROW.DCVisible"}}</span>
          {{else}}
            <span><i class="fas fa-eye-slash" aria-hidden="true"></i> {{localize "SAVING_THROW.DCHidden"}}</span>
          {{/if}}
          <span aria-live="polite">{{localize "SAVING_THROW.RolledCount" rolled=session.rolledCount total=session.totalCount}}</span>
        </div>
      </div>
    </header>

    <div class="st-card-grid">
      {{#each session.players}}
        <div class="st-card {{this.state}}">
          <div class="st-card-face">
            <img class="st-card-portrait" src="{{this.characterImg}}" alt="" />
            {{#if this.excluded}}
              <span class="st-card-badge"><i class="fas fa-user-slash" aria-hidden="true"></i> {{localize "SAVING_THROW.Excluded"}}</span>
            {{else if this.hasResult}}
              <span class="st-card-badge">
                <i class="fas {{#if this.success}}fa-check{{else}}fa-times{{/if}}" aria-hidden="true"></i>
                <span class="st-card-result">{{this.result}}</span>
              </span>
              {{#if this.manual}}
                <i class="fas fa-pen st-manual-mark" data-tooltip="{{localize "SAVING_THROW.ManualTag"}}"
                   aria-label="{{localize "SAVING_THROW.ManualTag"}}"></i>
              {{/if}}
            {{else}}
              <span class="st-card-badge"><i class="fas fa-hourglass-half" aria-hidden="true"></i></span>
            {{/if}}
          </div>
          <div class="st-card-name" data-tooltip="{{this.characterName}}">{{this.characterName}}</div>
          {{#unless ../session.resolved}}
            <div class="st-card-controls">
              {{#unless this.excluded}}
                <button type="button" data-action="setResult" data-user-id="{{this.userId}}"
                        data-tooltip="{{localize "SAVING_THROW.SetResult"}}" aria-label="{{localize "SAVING_THROW.SetResult"}}">
                  <i class="fas fa-pen"></i>
                </button>
              {{/unless}}
              {{#if this.excluded}}
                <button type="button" data-action="toggleExclude" data-user-id="{{this.userId}}"
                        data-tooltip="{{localize "SAVING_THROW.Include"}}" aria-label="{{localize "SAVING_THROW.Include"}}">
                  <i class="fas fa-user-plus"></i>
                </button>
              {{else}}
                <button type="button" data-action="toggleExclude" data-user-id="{{this.userId}}"
                        data-tooltip="{{localize "SAVING_THROW.Exclude"}}" aria-label="{{localize "SAVING_THROW.Exclude"}}">
                  <i class="fas fa-user-slash"></i>
                </button>
              {{/if}}
            </div>
          {{/unless}}
        </div>
      {{/each}}
    </div>

    {{#if session.isGroupMode}}
      <div class="st-group-meter">
        <div class="st-meter-label">
          <span>{{localize "SAVING_THROW.GroupSuccesses"}}</span>
          <span>{{localize "SAVING_THROW.SuccessesOfRequired" count=session.successCount required=session.required}}</span>
        </div>
        <div class="st-meter-track">
          <div class="st-meter-fill" style="width: {{session.successPercent}}%"></div>
          <div class="st-meter-tick" style="left: {{session.thresholdPercent}}%"></div>
        </div>
      </div>
    {{/if}}

    <div class="st-status">
      {{#if session.resolved}}
        {{#if session.isGroupMode}}
          <div class="st-banner {{#if session.groupSuccess}}success{{else}}failure{{/if}}">
            <i class="fas {{#if session.groupSuccess}}fa-shield-halved{{else}}fa-skull{{/if}}" aria-hidden="true"></i>
            <span>
              {{#if session.groupSuccess}}{{localize "SAVING_THROW.GroupSuccess"}}{{else}}{{localize "SAVING_THROW.GroupFailure"}}{{/if}}
              <small>{{session.modeLabel}} · {{session.successCount}}/{{session.totalCount}}</small>
            </span>
          </div>
        {{/if}}
      {{else if session.outlook}}
        <div class="st-banner {{#if (eq session.outlook "reached")}}success{{else}}failure{{/if}} soft">
          <i class="fas {{#if (eq session.outlook "reached")}}fa-flag-checkered{{else}}fa-triangle-exclamation{{/if}}" aria-hidden="true"></i>
          <span>
            {{#if (eq session.outlook "reached")}}{{localize "SAVING_THROW.OutlookReached"}}{{else}}{{localize "SAVING_THROW.OutlookUnreachable"}}{{/if}}
          </span>
        </div>
      {{else}}
        <p class="st-waiting-text">
          <i class="fas fa-hourglass-half" aria-hidden="true"></i> {{localize "SAVING_THROW.Waiting"}}
        </p>
      {{/if}}
    </div>

    <div class="st-actions">
      {{#if session.resolved}}
        <button type="button" data-action="newRequest">
          <i class="fas fa-redo"></i> {{localize "SAVING_THROW.NewRequest"}}
        </button>
      {{else}}
        <button type="button" data-action="resolveNow" data-tooltip="{{localize "SAVING_THROW.ResolveNowHint"}}"
                {{#unless session.canResolve}}disabled{{/unless}}>
          <i class="fas fa-flag-checkered"></i> {{localize "SAVING_THROW.ResolveNow"}}
        </button>
        <button type="button" data-action="cancelSession">
          <i class="fas fa-times"></i> {{localize "SAVING_THROW.Cancel"}}
        </button>
      {{/if}}
    </div>

  {{else}}
    {{!-- Setup form --}}
    {{#if hasPlayers}}
      <div class="st-form">
        <div class="st-dc-section">
          <div class="form-group">
            <label for="st-dc">{{localize "SAVING_THROW.DC"}}</label>
            <input id="st-dc" type="number" name="dc" value="15" min="1" max="99" />
          </div>
          <div class="form-group">
            <label class="checkbox">
              <input type="checkbox" name="dcVisible" checked />
              {{localize "SAVING_THROW.ShowDC"}}
            </label>
          </div>
        </div>

        <fieldset class="st-mode-group">
          <legend>{{localize "SAVING_THROW.ModeLabel"}}</legend>
          <div class="st-mode-options">
            {{#each modes}}
              <label class="st-mode-option" data-tooltip="{{this.tooltip}}">
                <input type="radio" name="mode" value="{{this.value}}" {{#if @first}}checked{{/if}} />
                <i class="fas {{this.icon}}" aria-hidden="true"></i>
                <span>{{this.label}}</span>
              </label>
            {{/each}}
          </div>
        </fieldset>

        <div class="form-group st-custom-threshold" hidden>
          <label for="st-required">{{localize "SAVING_THROW.RequiredSuccesses"}}</label>
          <input id="st-required" type="number" name="requiredSuccesses" value="1" min="1" />
        </div>

        <div class="st-player-section">
          <div class="st-player-header">
            <label>{{localize "SAVING_THROW.Players"}}</label>
            <div class="st-select-buttons">
              <button type="button" data-action="selectAll">{{localize "SAVING_THROW.SelectAll"}}</button>
              <button type="button" data-action="selectNone">{{localize "SAVING_THROW.SelectNone"}}</button>
            </div>
          </div>
          {{#each players}}
            <label class="st-player-option">
              <input type="checkbox" name="player" value="{{this.userId}}" checked />
              <img src="{{this.characterImg}}" alt="" width="32" height="32" />
              <span>{{this.characterName}} <small>({{this.playerName}})</small></span>
            </label>
          {{/each}}
        </div>

        <button type="button" data-action="requestRoll" class="st-request-btn">
          <i class="fas fa-dice-d20"></i> {{localize "SAVING_THROW.RequestRoll"}}
        </button>
      </div>
    {{else}}
      <p class="st-empty">{{localize "SAVING_THROW.Warn.NoPlayers"}}</p>
    {{/if}}
  {{/if}}
</div>
